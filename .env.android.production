# AdMob configuration for Play Store release builds (npm run build:android:release).
# Fill in your real IDs from the AdMob console (Apps > Pickle Smash > App settings / Ad units).
# The release build refuses to run while any of these is still a placeholder or a Google test ID.
VITE_ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
VITE_ADMOB_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
VITE_ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
VITE_ADMOB_IS_TESTING=false
